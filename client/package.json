{
  "name": "client2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3000",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean:vite": "node -e \"require('node:fs').rmSync('node_modules/.vite',{recursive:true,force:true});require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "type-check": "tsc --noEmit",
    "dev:build": "tsc && vite build && vite --host --port 3000",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:structure": "node tests/structure/design-system.mjs current",
    "test:structure:design": "node tests/structure/design-system.mjs design",
    "test:all": "npm run test:structure && playwright test",
    "test:design": "npm run test:structure:design && playwright test --config=playwright.design.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "^5.9.2",
    "vite": "^6.2.0"
  }
}
